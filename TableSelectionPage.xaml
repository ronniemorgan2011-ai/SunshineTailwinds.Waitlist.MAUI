<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SunshineTailwinds.Waitlist.MAUI.TableSelectionPage"
    Title="Select Table">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                x:Name="lblTitle"
                Text="Select Table"
                FontSize="24"
                FontAttributes="Bold" />

            <FlexLayout
                x:Name="TablesContainer"
                Wrap="Wrap"
                Direction="Row"
                JustifyContent="Start"
                AlignItems="Start" />

            <Button
                Text="Cancel"
                Clicked="Cancel_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>