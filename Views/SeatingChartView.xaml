<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SunshineTailwinds.Waitlist.MAUI.Views.SeatingChartView">

    <Border
    Stroke="Gray"
    Padding="10"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

        <Grid
            RowDefinitions="Auto,*">

            <Label
                Text="Seating Chart"
                FontSize="24"
                FontAttributes="Bold"
                Grid.Row="0" />

            <ScrollView
                Grid.Row="1"
                Orientation="Both">

                <AbsoluteLayout
                     x:Name="ChartLayout"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill">

                </AbsoluteLayout>

            </ScrollView>

        </Grid>

    </Border>

</ContentView>