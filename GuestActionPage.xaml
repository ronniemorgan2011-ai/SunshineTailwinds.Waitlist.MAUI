<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SunshineTailwinds.Waitlist.MAUI.GuestActionPage"
    Title="Guest Actions">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Button
    x:Name="SeatGuestButton"
    Text="🍽️ Seat Guest"
    BackgroundColor="#FFE082"
    TextColor="Black" />

            <Button
    x:Name="PreSeatButton"
    Text="📝 Assign Table" />

            <Button
    x:Name="OrdersInButton"
    Text="🍳 Orders In"
    BackgroundColor="#F48FB1"
    TextColor="Black" />

            <Button
    x:Name="ClosePartyButton"
    Text="✅ Close Party"
    BackgroundColor="#4CAF50"
    TextColor="White" />

            <BoxView
    HeightRequest="1"
    Color="Gray"
    Margin="0,10" />

            <Button
    x:Name="MoreOptionsButton"
    Text="⚙️ More Options" />

            <Button
    x:Name="CancelButton"
    Text="❌ Cancel" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>