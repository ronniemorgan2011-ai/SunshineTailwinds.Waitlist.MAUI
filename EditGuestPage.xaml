<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SunshineTailwinds.Waitlist.MAUI.EditGuestPage"
    Title="Edit Guest">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Edit Guest"
                FontSize="24"
                FontAttributes="Bold" />

            <Label Text="Guest Name" />

            <Entry
                x:Name="txtGuestName" />

            <Label Text="Adults" />

            <Entry
                x:Name="txtAdults"
                Keyboard="Numeric" />

            <Label Text="Children" />

            <Entry
                x:Name="txtChildren"
                Keyboard="Numeric" />

            <HorizontalStackLayout>

                <CheckBox
                    x:Name="chkHighChair" />

                <Label
                    Text="High Chair"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <Button
                Text="Save Changes"
                Clicked="Save_Clicked" />

            <Button
                Text="Cancel"
                Clicked="Cancel_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>