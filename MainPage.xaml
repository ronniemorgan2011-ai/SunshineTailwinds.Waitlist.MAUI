<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SunshineTailwinds.Waitlist.MAUI.MainPage">

    <ScrollView
        Orientation="Vertical">

        <VerticalStackLayout
    Padding="15"
    Spacing="10">

            <!-- ADD GUEST -->

            <Border
        Stroke="Gray"
        Padding="15">

                <VerticalStackLayout
            Spacing="10">

                    <Label
                Text="Add Guest"
                FontSize="24"
                FontAttributes="Bold" />

                    <HorizontalStackLayout
                Spacing="10">

                        <Entry
                    x:Name="txtGuestName"
                    Placeholder="Guest Name"
                    WidthRequest="250" />

                        <Entry
                    x:Name="txtAdults"
                    Placeholder="Adults"
                    Keyboard="Numeric"
                    WidthRequest="90" />

                        <Entry
                    x:Name="txtChildren"
                    Placeholder="Children"
                    Keyboard="Numeric"
                    WidthRequest="90" />

                        <HorizontalStackLayout
                    VerticalOptions="Center">

                            <CheckBox
                        x:Name="chkHighChair" />

                            <Label
                        Text="High Chair"
                        VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <Button
                    Text="Add Guest"
                    WidthRequest="140"
                    Clicked="AddGuest_Clicked" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>
            <Grid
                ColumnDefinitions="*,180">

                <Label
                Text="{Binding SelectedGuest.GuestName,
                StringFormat='Selected Guest: {0}'}"
                FontSize="18"
                VerticalOptions="Center" />
                
                <Button
                    Grid.Column="1"
                    Text="End of Day"
                    Clicked="ClearGuests_Clicked" />

            </Grid>
            <Border
                Stroke="Gray"
                Padding="15">

                <VerticalStackLayout>

                    <Label
                        Text="Active Waitlist"
                        FontSize="24"
                        FontAttributes="Bold"/>

                    <Grid
    ColumnDefinitions="2.5*,0.8*,0.8*,0.6*,1.4*,0.8*,0.5*"
    Padding="5">

                        <Label Grid.Column="0" Text="Guest" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="Ad" FontAttributes="Bold"/>
                                <Label Grid.Column="2" Text="Kids" FontAttributes="Bold"/>
                                  <Label Grid.Column="3" Text="Time" FontAttributes="Bold"/>
                                    <Label Grid.Column="4" Text="Status" FontAttributes="Bold"/>
                                        <Label Grid.Column="5" Text="Tbl" FontAttributes="Bold"/>
                                            <Label Grid.Column="6" Text="⋮" FontAttributes="Bold"/>

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="Gray"
                        Margin="0,0,0,5"/>

                    <CollectionView
                        ItemsSource="{Binding Guests}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedGuest}">

                        <CollectionView.ItemTemplate>

                            <DataTemplate>

                                <Grid
                ColumnDefinitions="2.5*,0.8*,0.8*,0.6*,1.4*,0.8*,0.5*"
                Padding="5">
                    <Label Grid.Column="0" Text="{Binding GuestDisplay}" FontSize="16" />

                                    <Label
                    Grid.Column="1"
                    Text="{Binding Adults}"
                    FontSize="16" />

                                    <Label
                    Grid.Column="2"
                    Text="{Binding Children}"
                    FontSize="16" />

                    <Label
                        Grid.Column="3"
                        Text="{Binding TimeAdded}"
                        FontSize="16" />

                                    <Border
                    Grid.Column="4"
                    BackgroundColor="{Binding StatusColor}"
                    StrokeThickness="0"
                    Padding="4">

                                        <Label
                        Text="{Binding Status}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        FontAttributes="Bold"
                        FontSize="16" />

                                    </Border>

                                    <Border
                    Grid.Column="5"
                    BackgroundColor="{Binding StatusColor}"
                    StrokeThickness="0"
                    Padding="4">

                                        <Label
                        Text="{Binding TableNumber}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        FontAttributes="Bold"
                        FontSize="16" />

                                    </Border>

                                    <Button
                    Grid.Column="6"
                    Text="⋮"
                    FontSize="18"
                    WidthRequest="40"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"                    
                    CommandParameter="{Binding Id}"
                    Clicked="GuestActionMenu_Clicked" />

                                </Grid>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>


                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>