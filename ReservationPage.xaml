<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SunshineTailwinds.Waitlist.MAUI.ReservationPage"
    Title="Reservation">

    <VerticalStackLayout
        Padding="20"
        Spacing="20">

        <Label
            Text="Reservation Time"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Picker
            x:Name="ReservationTimePicker"
            Title="Select Reservation Time" />

        <Button
            Text="Save"
            Clicked="Save_Clicked" />

        <Button
            Text="Cancel"
            Clicked="Cancel_Clicked" />

    </VerticalStackLayout>

</ContentPage>