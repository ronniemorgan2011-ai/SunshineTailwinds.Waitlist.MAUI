<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SunshineTailwinds.Waitlist.MAUI.DashboardPage"
    Title="Dashboard">

    <ScrollView>

        <Border
            Margin="20"
            Padding="20"
            Stroke="Gray">

            <VerticalStackLayout
                Spacing="15">

                <Label
                    Text="Today's Summary"
                    FontSize="24"
                    FontAttributes="Bold"/>

                <Label
                    Text="{Binding WaitingCount,
                           StringFormat='Waiting: {0}'}"
                    FontSize="18"/>

                <Label
                    Text="{Binding SeatedCount,
                           StringFormat='Seated: {0}'}"
                    FontSize="18"/>

                <Label
                    Text="{Binding GuestCount,
                           StringFormat='Guests: {0}'}"
                    FontSize="18"/>

                <Label
                    Text="{Binding OccupiedCount,
                           StringFormat='Occupied: {0}'}"
                    FontSize="18"/>

                <BoxView
                    HeightRequest="1"
                    Color="Gray"/>

                <Label
                    Text="{Binding CurrentWaitMinutes,
                           StringFormat='Selected Guest Wait: {0} Minutes'}"
                    FontSize="18"/>

                <Label
                    Text="{Binding LongestWaitMinutes,
                           StringFormat='Longest Wait: {0} Minutes'}"
                    FontSize="18"/>

            </VerticalStackLayout>

        </Border>

    </ScrollView>

</ContentPage>